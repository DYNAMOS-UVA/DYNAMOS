# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
build
dist
dynamos.egg.info/*
*dynamos.egg-info
.obsidian/
.venv
.query
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
log.txt
# Test binary, built with `go test -c`
*.test
__pycache__
# TEMP
definitions.json
definitions.bak
*.DS_Store
# Output of the go coverage tool, specifically when used with LiteIDE
*.out
*.vscode
# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
__debug_bin
node_modules
.env
.env.local
datasets/*.csv

*.drawio.bkp
*.drawio.dtmp

# DSP TCK run output (go/cmd/dsp-connector/tck/run-tck.sh) - reproducible
# evidence, not something to keep committed
go/cmd/dsp-connector/tck/*.log

# `go build ./cmd/<service>/...` run from go/ writes a bare binary named
# after the package straight into go/ - no extension, so *.exe/*.dll/*.so
# above don't catch it. Listed per-service rather than a blanket rule,
# since go/dsp-connector is a real pre-existing tracked binary at this
# exact path (unrelated repo-hygiene debt, not touched here).
/go/transfer-process-service
/go/negotiation-service
/go/catalog-service
/go/api-gateway
/go/orchestrator
/go/agent
/go/sidecar
/go/policy-enforcer
